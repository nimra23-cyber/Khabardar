# Frontend production environment (EXAMPLE). Copy to `.env.production` or set
# in the Vercel project settings. Do NOT commit real values.
#
# Base URL of the deployed backend API (no trailing slash). The SPA calls
# `${VITE_API_BASE_URL}/api/...`. Leave empty only if the frontend is served
# same-origin as the backend (not the case for Vercel + Render).
VITE_API_BASE_URL=https://YOUR-BACKEND-HOST.onrender.com
