# KHABARDAR backend configuration (EXAMPLE)
# Copy to `.env` and fill values. ALL keys below are OPTIONAL.
# The application runs fully on the rule-based / local path with NONE of them set.
# NEVER commit a real .env file. NEVER put these values in the frontend.

# ===== Server (local-only) =====
# The backend binds to localhost. Do not change to 0.0.0.0 without Req 18 auth.
KHABARDAR_HOST=127.0.0.1
KHABARDAR_PORT=8000

# Comma-separated CORS allowlist (frontend dev origin by default). For a public
# deployment set this to the EXACT frontend origin(s) only -- never a wildcard.
KHABARDAR_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ===== Public demo mode =====
# When true, the backend runs as an UNAUTHENTICATED public demo: scan-history
# persistence AND the /api/history endpoint are DISABLED so no shared record
# store is exposed to anonymous visitors. Text detection still works fully.
# Leave false/unset for local single-user development (history enabled).
KHABARDAR_PUBLIC_DEMO=false

# ===== Database =====
# SQLite for local dev. PostgreSQL-compatible schema for future deployment.
KHABARDAR_DATABASE_URL=sqlite:///./khabardar.db

# ===== Privacy / retention (days, 1..3650) =====
KHABARDAR_RETENTION_DAYS=90

# Per-install secret salt for one-way identifier hashing (Req 21.3).
# Treated as a SECRET: never logged, never serialized, never sent to the
# frontend. One-way hashing (hash_identifier) FAILS CLOSED if this is unset or
# shorter than 32 chars -- there is NO derived fallback (a predictable key is
# not a secret). Masking of scan content does NOT require this; only explicit
# identifier hashing does. Generate a strong value with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
KHABARDAR_HASH_SALT=

# ===== Optional AI providers (Module A enhancement; rule-based works without these) =====
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=

# ===== Optional URL threat-intel integrations (Module B; honest "unavailable" without these) =====
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_KEY=
URLSCAN_KEY=

# ===== Media (Phase 4) =====
# Path to the Tesseract binary on Windows (UB-Mannheim default shown). Leave blank to use PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
